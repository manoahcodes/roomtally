{
  "name": "roomtally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Roomtally: a free, private home project estimator for paint, flooring, tile and wallpaper.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-bundle-size.mjs",
    "seo:check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "tailwindcss": "4.3.5",
    "vanilla-cookieconsent": "3.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
