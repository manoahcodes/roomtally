---
/**
 * Shared wrapper for each single-material calculator page (App_Flow §A.1, Design_Brief §B.12):
 * breadcrumbs, heading, intro, then the form and the results side by side from 1024px and
 * stacked below. Two ad slots sit outside the form and results. The FAQ block also emits the
 * page's FAQPage JSON-LD, so pass the same items only here.
 *
 * Optional props for the room-type pages: `breadcrumbs` for the trail and `preset` to fill
 * the form with a typical room. The default slot is for extra content after the results.
 */
import AdSlot from '../ads/AdSlot.astro';
import Breadcrumbs from '../common/Breadcrumbs.astro';
import DisclaimerNote from '../common/DisclaimerNote.astro';
import FaqBlock from '../common/FaqBlock.astro';
import RoomForm from '../room/RoomForm.astro';
import ShoppingList from '../results/ShoppingList.astro';

export interface Props {
  title: string;
  intro: string;
  material: string;
  faq: { q: string; a: string }[];
  breadcrumbs?: { name: string; href: string }[];
  preset?: object;
}

const { title, intro, material, faq, breadcrumbs, preset } = Astro.props;
---

<div class="space-y-8">
  <div>
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <h1>{title}</h1>
    <p class="mt-3 max-w-prose text-lg text-ink-700 dark:text-dark-muted">{intro}</p>
  </div>

  <div class="grid items-start gap-8 lg:grid-cols-2">
    <div class="space-y-4">
      <RoomForm mode="single" material={material} preset={preset} />
      {
        preset && (
          <a href="/" data-add-to-project class="btn btn-secondary">
            Add to my project
          </a>
        )
      }
    </div>
    <ShoppingList mode="single" material={material} />
  </div>

  <AdSlot slotKey="inarticle" />

  <slot />

  <FaqBlock items={faq} />
  <DisclaimerNote variant="short" />
  <AdSlot slotKey="bottom" />
</div>
