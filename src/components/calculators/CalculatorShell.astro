---
/**
 * Shared wrapper for each single-material calculator page (App_Flow §A.1, Design_Brief §B.12):
 * breadcrumbs, a ruled page head with the material stamp, the shared calculator
 * navigation, then the form and the results side by side from 1024px and stacked below.
 * Two ad slots sit outside the form and results. The FAQ block also emits the page's
 * FAQPage JSON-LD, so pass the same items only here.
 *
 * Optional props for the room-type pages: `breadcrumbs` for the trail and `preset` to fill
 * the form with a typical room. The default slot is for extra content after the results.
 */
import AdSlot from '../ads/AdSlot.astro';
import Breadcrumbs from '../common/Breadcrumbs.astro';
import DisclaimerNote from '../common/DisclaimerNote.astro';
import FaqBlock from '../common/FaqBlock.astro';
import MaterialIcon from '../common/MaterialIcon.astro';
import CalculatorNav from './CalculatorNav.astro';
import RoomForm from '../room/RoomForm.astro';
import ShoppingList from '../results/ShoppingList.astro';

export interface Props {
  title: string;
  intro: string;
  material: 'paint' | 'flooring' | 'tile' | 'wallpaper';
  faq: { q: string; a: string }[];
  breadcrumbs?: { name: string; href: string }[];
  preset?: object;
}

const { title, intro, material, faq, breadcrumbs, preset } = Astro.props;
---

<div class="space-y-8">
  <header class="page-head grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <p class="page-kicker mb-3">
        <MaterialIcon name={material} class="size-4" />
        Free estimate in your browser
      </p>
      <h1>{title}</h1>
      <p class="mt-3 max-w-prose text-lead text-ink-700 dark:text-dark-muted">{intro}</p>
    </div>
    <div class="material-stamp" aria-hidden="true">
      <MaterialIcon name={material} size={52} />
    </div>
  </header>

  <CalculatorNav current={material} />

  <div class="grid items-start gap-8 lg:grid-cols-2">
    <div class="min-w-0 space-y-4">
      <RoomForm mode="single" material={material} preset={preset} />
      {preset && (
        <a href="/" data-add-to-project class="btn btn-secondary w-full sm:w-auto">
          Add to my project
        </a>
      )}
    </div>
    <ShoppingList mode="single" material={material} />
  </div>

  <AdSlot slotKey="inarticle" />

  <slot />

  <FaqBlock items={faq} />
  <DisclaimerNote variant="short" />
  <AdSlot slotKey="bottom" />
</div>

<script>
  import { bindRoomForm } from '../../lib/ui/bindRoomForm';
  import { bindPrintButtons } from '../../lib/ui/printList';

  bindRoomForm();
  bindPrintButtons();
</script>
