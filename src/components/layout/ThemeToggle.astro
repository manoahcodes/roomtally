---
/**
 * Light/dark switch (Design_Brief §B.15). Light is the default for everyone.
 * Sets data-theme on <html> and remembers the choice under roomtally:theme.
 * The first-paint script in BaseLayout applies a saved theme before the page shows.
 * Adapted from the idea in astrowind's CustomStyles.astro (MIT): attribute on <html>, saved choice.
 * Hook: [data-theme-toggle]
 */
---

<button
  type="button"
  data-theme-toggle
  class="btn btn-ghost px-3"
  aria-label="Switch to dark theme"
  aria-pressed="false"
>
  <svg
    class="size-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg
    class="hidden size-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  import { readTheme, writeTheme } from '../../lib/state/storage';
  import type { ThemePreference } from '../../lib/state/storage';

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function apply(theme: ThemePreference): void {
    root.setAttribute('data-theme', theme);
    const dark = theme === 'dark';
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(dark));
      button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    }
  }

  apply(readTheme());

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const next: ThemePreference = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      apply(next);
      writeTheme(next);
    });
  }
</script>
