---
/**
 * Not-found page (App_Flow §A.1, TDD §G.48 NAV_404). Search-free recovery: links to the
 * home estimator, the four calculators and the guides. No ads on a page with no content.
 * The missing paper sheet is decorative; the recovery links carry the page.
 */
import { ERRORS } from '../lib/calc/errors';
import BaseLayout from '../layouts/BaseLayout.astro';
import { legalMeta } from '../lib/seo/meta';

const meta = legalMeta(
  'Page not found',
  'This page does not exist. Go back to the home page, a calculator or a guide.',
  '/404/',
);

const links = [
  {
    href: '/',
    name: 'Home estimator',
    text: 'One shopping list for paint, flooring, tile and wallpaper.',
  },
  { href: '/paint-calculator/', name: 'Paint calculator', text: 'Cans of paint for a room.' },
  {
    href: '/flooring-calculator/',
    name: 'Flooring calculator',
    text: 'Boxes of flooring with waste.',
  },
  {
    href: '/tile-calculator/',
    name: 'Tile calculator',
    text: 'Tiles and boxes for a floor or wall.',
  },
  { href: '/wallpaper-calculator/', name: 'Wallpaper calculator', text: 'Rolls of wallpaper.' },
  { href: '/guides/', name: 'Guides', text: 'Plain advice on measuring and buying.' },
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  noAds
>
  <section class="grid gap-12 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-6">
      <p class="page-kicker">Error 404</p>
      <h1 id="not-found-heading" class="mt-3">
        {ERRORS.NAV_404.userMessage}
      </h1>
      <p class="mt-4 max-w-prose text-lead text-ink-700 dark:text-dark-muted">
        The link may be old, or the address may have a typo. Try one of these instead.
      </p>
      <ul class="mt-8 grid gap-x-8 border-t border-cream-300 sm:grid-cols-2 dark:border-dark-border">
        {links.map((link) => (
          <li class="row-link">
            <div class="py-4">
              <h2 class="text-h4">
                <a href={link.href}>{link.name}</a>
              </h2>
              <p class="mt-0.5 text-sm text-ink-700 dark:text-dark-muted">{link.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-5 lg:col-start-8">
      <div class="hero-sheet" aria-hidden="true">
        <div class="sheet-paper">
          <div class="flex items-baseline justify-between gap-3">
            <span class="sheet-brand">Beautally</span>
            <span class="sheet-number">No. 404</span>
          </div>
          <p class="mt-8 font-heading text-[4.5rem] leading-none tracking-tight text-clay-600 dark:text-dark-clay">
            404
          </p>
          <p class="mt-3 text-sm text-ink-700 dark:text-dark-muted">
            This sheet is not in the stack.
          </p>
          <div class="sheet-perf"></div>
          <div class="sheet-foot">
            <p>Try the index instead.</p>
            <span class="sheet-stamp">Not found</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
