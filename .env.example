# Copy to .env and fill in what you need.
# Every PUBLIC_ variable is readable by every visitor. Never put a secret here.

# Canonical origin, no trailing slash (required)
PUBLIC_SITE_URL=https://roomtally.example

# Ads (off by default)
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
PUBLIC_ADSENSE_SLOT_INARTICLE=0000000000
PUBLIC_ADSENSE_SLOT_BOTTOM=0000000000

# Affiliate links (off by default)
PUBLIC_AFFILIATES_ENABLED=false
PUBLIC_AFFILIATE_TAG_AMAZON_US=example-20
PUBLIC_AFFILIATE_TAG_AMAZON_UK=example-21
PUBLIC_AFFILIATE_TAG_AMAZON_CA=example-20
PUBLIC_AFFILIATE_TAG_AMAZON_AU=example-22

# Analytics (off by default; still needs consent)
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_CF_BEACON_TOKEN=

# CI only: set these as GitHub Actions secrets, never in a file
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
